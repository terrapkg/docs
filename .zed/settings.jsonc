// TS support is built into Zed
{
  "auto_install_extensions": {
    "MDX": true,
    "Astro": true,
  },
  "languages": {
    "MDX": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "prettier", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },
}
