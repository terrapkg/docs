{
  "$schema": "./node_modules/@lunariajs/core/config.schema.json",
  "repository": {
    "name": "terrapkg/docs",
    "rootDir": "src/content/docs"
  },
  "defaultLocale": {
    "label": "English",
    "lang": "en"
  },
  "locales": [],
  "files": [
    {
      "location": "src/content/docs/**/*.{md,mdx}",
      "pattern": "src/content/docs/@lang/@path",
      "type": "universal"
    }
  ],
  "dashboard": {
    "title": "Terra Docs Translation Status",
    "description": "Translation progress tracker for the Terra documentation site. See what we currently have, and feel free to help!",
    "favicon": {
      "external": [
        {
          "link": "https://docs.terrapkg.com/favicon.svg",
          "type": "image/svg+xml"
        }
      ]
    },
    "ui": {
      "statusByLocale.heading": "Translation progress by locale",
      "statusByLocale.incompleteLocalizationLink": "Incomplete",
      "statusByLocale.outdatedLocalizationLink": "Outdated",
      "statusByLocale.completeLocalization": "Complete!",
      "statusByFile.heading": "Translation status by file"
    }
  }
}
