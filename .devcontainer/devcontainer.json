{
  "name": "Terra Docs",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "USERNAME": "${localEnv:USER}",
      "PNPM_VERSION": "12"
    }
  },
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro Dev Server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "hideoo.starlight-links",
        "oxc.oxc-vscode"
      ]
    },
    "zed": {
      "extensions": ["oxc"]
    }
  }
}
